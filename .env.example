# ==============================================================================
# OmniMCP — Environment Configuration
# ==============================================================================

# Application Environment
# Options: development | production | test
NODE_ENV=development

# Server Binding
# In local development: 127.0.0.1 (loopback only, recommended for safety)
# In Docker / Production: 0.0.0.0 (required to accept incoming connections through containers)
HOST=127.0.0.1
PORT=3000

# Logging verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Headless / Container execution: set to true to prevent auto-opening desktop browser window
NO_BROWSER_OPEN=false

# ==============================================================================
# Security & Cryptographic Vault (MANDATORY IN PRODUCTION)
# ==============================================================================
# Master 64-character hex key (32 bytes AES-256-GCM) used to encrypt stored credentials.
# In development, an ephemeral key is generated per process session if omitted.
# In production (NODE_ENV=production), startup will FAIL if this key is missing or invalid.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OMNIMCP_ENCRYPTION_KEY=

# ==============================================================================
# Role-Separated Gateway Credentials
# ==============================================================================
# 1. Operator Token: Human administrator credentials for dashboard access,
#    approval queue management, and server registry mutations.
#    Must NOT be shared with AI coding agents or MCP clients.
OMNIMCP_OPERATOR_TOKEN=

# 2. Agent Token: Default credentials provisioned to client agents (Antigravity, Cursor, etc.)
#    Can invoke tools subject to profile boundaries and RBAC approval gates.
#    Automatically seeded into SQLite agent_tokens on startup with OMNIMCP_DEFAULT_AGENT_PROFILE (default: developer).
OMNIMCP_AGENT_TOKEN=

# 3. Optional Per-Agent Tokens: JSON map or comma-separated "agentId:token" mapping for individual client isolation
# Example JSON: OMNIMCP_AGENT_TOKENS={"ci-runner":{"token":"secret_abc","profile":"developer"},"qa-bot":{"token":"secret_xyz","profile":"readonly"}}
# Dynamic tokens can also be generated and managed at runtime via /api/agent-tokens (persisted in SQLite).
OMNIMCP_AGENT_TOKENS=

# Legacy Single-Secret Fallback (Maps to AGENT token if set alone; deprecated in favor of role tokens)
OMNIMCP_AUTH_TOKEN=

# ==============================================================================
# Persistence & Database
# ==============================================================================
# SQLite WAL Database path.
# Local development default: ./data/omnimcp.db
# Docker production default: /app/data/omnimcp.db (mounted to persistent volume)
SQLITE_DB_PATH=./data/omnimcp.db
OMNIMCP_DB_PATH=./data/omnimcp.db # Alias for SQLITE_DB_PATH

# Optional future multi-instance relational database URL (PostgreSQL)
DATABASE_URL=

# ==============================================================================
# Downstream MCP Integrations (Optional — configure what you use)
# ==============================================================================

# Local Filesystem MCP
ALLOWED_DIRECTORIES=c:\OmniMCP

# GitHub MCP
GITHUB_PERSONAL_ACCESS_TOKEN=

# Context7 (Upstash Documentation MCP)
CONTEXT7_API_KEY=

# Playwright Browser Automation MCP
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# Supabase MCP
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# shadcn/ui MCP
SHADCN_COMPONENTS_PATH=./components/ui

# Sentry MCP
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_HOST=https://sentry.io

# ==============================================================================
# Google Stitch Remote MCP Server (https://stitch.googleapis.com/mcp)
# ==============================================================================
# API Key for Google Stitch hosted MCP endpoint.
# When set, OmniMCP auto-connects to Stitch and discovers design generation tools.
# Never expose this key. Configure this as an encrypted secret in Voroa or your server environment.
STITCH_API_KEY=
# Timeout for design generation requests in milliseconds (default: 120000ms / 2 minutes)
STITCH_TIMEOUT_MS=120000
