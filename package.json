{
  "name": "omnimcp",
  "version": "1.0.0",
  "description": "OmniMCP — Centralized MCP Gateway & Management Platform",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "omnimcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js --http",
    "dev": "node dist/index.js --http",
    "gateway": "tsx src/index.ts",
    "gateway:stdio": "tsx src/index.ts --stdio",
    "gateway:http": "tsx src/index.ts --http",
    "gateway:all": "tsx src/index.ts --all",
    "dashboard": "node dist/index.js --http",
    "agent:work": "node scripts/agent-takeover.js",
    "agent:browse": "node scripts/agent-takeover.js",
    "test": "vitest run",
    "test:node": "tsx --test tests/db_profiles_kanban.test.ts tests/profiles_engine.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@magnusrodseth/shadcn-mcp-server": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server-filesystem": "^2.2.0",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@playwright/mcp": "^0.0.84",
    "@sentry/mcp-server": "^0.49.0",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/context7-mcp": "^4.5.1",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
